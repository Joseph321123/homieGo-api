PORT=3000

# PostgreSQL dedicado a HomieGo
DB_HOST=postgres
DB_PORT=5432
DB_NAME=homiego_db
DB_USER=homiego_user
DB_PASSWORD=homiego_pass

# Notas:
# - Con Docker (recomendado): usa los valores de arriba. docker-compose
#   conecta la API al servicio "postgres" de la red interna.
# - Sin Docker (solo API local + BD en contenedor): usa DB_HOST=localhost
#   y DB_PORT=5433, luego ejecuta solo el servicio postgres con:
#   docker compose up -d postgres
